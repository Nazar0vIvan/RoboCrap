&ACCESS RV
&PARAM EDITMASK = *
&PARAM TEMPLATE = C:\KRC\Roboter\Template\vorgabe
DEF RSI_Probe_Scan( )
DECL INT Step
DECL INT SearchResult
DECL E6POS SearchStart

$OUT[2]=FALSE
;FOLD INI;%{PE}
  ;FOLD BASISTECH INI
    GLOBAL INTERRUPT DECL 3 WHEN $STOPMESS==TRUE DO IR_STOPM ( )
    INTERRUPT ON 3
    BAS (#INITMOV,0 )
  ;ENDFOLD (BASISTECH INI)
  ;FOLD USER INI
    ;Make your modifications here

  ;ENDFOLD (USER INI)
;ENDFOLD (INI)

$ADVANCE=0
$SEN_PINT[1]=0
$SEN_PINT[2]=0
$SEN_PINT[3]=0
IF RSI_RESET()<>RSIOK THEN
   RETURN
ENDIF
IF NOT READ_JOB() THEN
   RETURN
ENDIF

;FOLD PTP HOME (INIT_PTP_VEL)
$BWDSTART = FALSE
PDAT_ACT=PDEFAULT
FDAT_ACT=FHOME
BAS (#PTP_PARAMS,20 )
INIT_PTP_VEL ( )
$H_POS=XHOME
PTP  XHOME
;ENDFOLD

$BASE=$NULLFRAME
$TOOL=ToolFrame
$IPO_MODE=#BASE
$ORI_TYPE=#CONSTANT
$VEL.CP=TransferVelocity
$ACC.CP=TransferAcceleration
FOR Step=1 TO 6
   $ACC_AXIS[Step]=20
ENDFOR
IF RSI_CREATE("RSI_Probe_Calibration.rsi")<>RSIOK THEN
   RETURN
ENDIF

FOR Step=1 TO StepCount-1
   SWITCH StepKind[Step]
   CASE 1
      PTP StepTarget[Step]
   CASE 2
      LIN StepTarget[Step]
   CASE 4
      SearchStart=$POS_ACT
      IF $IN[8] THEN
         RETURN
      ENDIF
      SearchResult=PROBE_SEARCH(StepTouch[Step])
      IF SearchResult<>1 THEN
         IF SearchResult==0 THEN
            LIN SearchStart
         ENDIF
         RETURN
      ENDIF
   ENDSWITCH
ENDFOR
;FOLD PTP HOME (INIT_PTP_VEL)
$BWDSTART = FALSE
PDAT_ACT=PDEFAULT
FDAT_ACT=FHOME
BAS (#PTP_PARAMS,20 )
INIT_PTP_VEL ( )
$H_POS=XHOME
PTP  XHOME
;ENDFOLD

WAIT SEC 0
$OUT[2]=TRUE
END

DEFFCT BOOL READ_JOB()
   DECL STATE_T State
   DECL MODUS_T Mode
   DECL INT File, Version, Step, Kind, Offset, LineCodes
   DECL CHAR LineEnds[4], Tail
   DECL BOOL Ok

   Mode=#SYNC
   File=0
   StepCount=0
   TransferVelocity=0.0
   TransferAcceleration=0.0
   ; CR (0D), LF (0A) in the first two bytes of a little-endian INT.
   LineCodes='H0A0D'
   Offset=0
   CAST_TO(LineEnds[],Offset,LineCodes)
   IF NOT REMOUNT_SHARE() THEN
      RETURN FALSE
   ENDIF
   CWRITE($FCT_CALL,State,Mode,"krl_fopen","/RoboCrapJobs/scan_data.txt","r",File)
   IF State.RET1<>#DATA_OK THEN
      RETURN FALSE
   ENDIF

   ; Version 1: see RSI_Probe_Scan_CONTRACT.md.
   Version=0
   CWRITE($FCT_CALL,State,Mode,"krl_fscanf",File,"%d",Version)
   Ok=(State.RET1==#DATA_OK) AND (Version==1)
   ToolFrame=READ_FRAME(File,Ok)
   CWRITE($FCT_CALL,State,Mode,"krl_fscanf",File,"%f",TransferVelocity)
   Ok=Ok AND (State.RET1==#DATA_OK) AND (TransferVelocity>0) AND (TransferVelocity<=$VEL_MA.CP)
   CWRITE($FCT_CALL,State,Mode,"krl_fscanf",File,"%f",TransferAcceleration)
   Ok=Ok AND (State.RET1==#DATA_OK) AND (TransferAcceleration>0) AND (TransferAcceleration<=$ACC_MA.CP)
   CWRITE($FCT_CALL,State,Mode,"krl_fscanf",File,"%d",StepCount)
   Ok=Ok AND (State.RET1==#DATA_OK) AND (StepCount>=6) AND (StepCount<=600)
   Step=1
   WHILE Ok AND (Step<=StepCount)
      ; Invalid defaults also reject an incomplete conversion.
      StepKind[Step]=0
      StepTouch[Step]=-1
      CWRITE($FCT_CALL,State,Mode,"krl_fscanf",File,"%d;%d",StepKind[Step],StepTouch[Step])
      Kind=StepKind[Step]
      Ok=(State.RET1==#DATA_OK) AND (Kind>=1) AND (Kind<=5) AND (Kind<>3)
      IF Ok AND ((Kind==1) OR (Kind==2)) THEN
         StepTarget[Step]=READ_POS(File,Ok)
      ENDIF
      Step=Step+1
   ENDWHILE

   IF Ok THEN
      Ok=VALID_ROUTE()
   ENDIF

   ; Accept only CR/LF up to actual EOF.
	 Tail=" "
   WHILE Ok
      CWRITE($FCT_CALL,State,Mode,"krl_fgetc",File,Tail)
      IF State.RET1<>#DATA_OK THEN
         Ok=(State.MSG_NO==-4)
         EXIT
      ENDIF
      Ok=(Tail==LineEnds[1]) OR (Tail==LineEnds[2])
   ENDWHILE
   CWRITE($FCT_CALL,State,Mode,"krl_fclose",File)
   RETURN Ok AND (State.RET1==#DATA_OK)
ENDFCT

DEFFCT BOOL VALID_ROUTE()
   DECL INT Step, Searches
   DECL POS StartPos, RetractPos

   ; The reader has loaded 6..600 complete steps.
   IF (StepKind[1]<>1) OR (StepKind[StepCount]<>5) OR (StepTouch[1]<>0) OR (StepTouch[StepCount]<>0) THEN
      RETURN FALSE
   ENDIF
   ; The last four steps are SEARCH, retract, retreat, HOME.
   IF (StepKind[StepCount-3]<>4) OR (StepKind[StepCount-1]<>2) THEN
      RETURN FALSE
   ENDIF
   Searches=0
   FOR Step=2 TO StepCount-1
      IF StepKind[Step]==4 THEN
         Searches=Searches+1
         IF (StepTouch[Step]<>Searches) OR (StepKind[Step-1]<>2) OR (StepKind[Step+1]<>2) THEN
            RETURN FALSE
         ENDIF
         StartPos=StepTarget[Step-1]
         RetractPos=StepTarget[Step+1]
         IF (StartPos.X<>RetractPos.X) OR (StartPos.Y<>RetractPos.Y) OR (StartPos.Z<>RetractPos.Z) THEN
            RETURN FALSE
         ENDIF
         IF (StartPos.A<>RetractPos.A) OR (StartPos.B<>RetractPos.B) OR (StartPos.C<>RetractPos.C) THEN
            RETURN FALSE
         ENDIF
         IF (StartPos.S<>RetractPos.S) OR (StartPos.T<>RetractPos.T) THEN
            RETURN FALSE
         ENDIF
      ELSE
         IF (StepKind[Step]<>2) OR (StepTouch[Step]<>0) THEN
            RETURN FALSE
         ENDIF
      ENDIF
   ENDFOR
   RETURN TRUE
ENDFCT
